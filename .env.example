# Salin ke .env lalu sesuaikan. Semua punya default aman.

# true  = model dummy (tanpa torch/dataset) — untuk uji integrasi Fase A.
# false = muat bobot asli dari MODEL_PATH (Fase B, setelah model dilatih).
STUB_MODE=true

# Lokasi bobot terlatih (dipakai saat STUB_MODE=false).
MODEL_PATH=models/model.pt

# Origin PWA warga yang boleh memanggil (pisah koma). Sesuaikan saat deploy.
ML_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Batas ukuran foto (byte). Default 5 MB, samakan dengan aturan foto laporan.
MAX_UPLOAD_BYTES=5242880
